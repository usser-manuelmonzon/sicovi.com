APP_NAME=SICOVI
APP_ENV=production
APP_DEBUG=false
APP_KEY=CONFIGURAR_CLAVE_LARAVEL_EXISTENTE_O_NUEVA_SOLO_PRIMERA_INSTALACION
APP_URL=https://CONFIGURAR_SERVICIO.onrender.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
DISPLAY_TIMEZONE=America/Guatemala
TRUSTED_PROXIES=*
DB_CONNECTION=pgsql
DB_HOST=CONFIGURAR_HOST_DE_CONEXION_O_SESSION_POOLER
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=CONFIGURAR_ROL_Y_REFERENCIA_SEGUN_CONEXION
DB_PASSWORD=CONFIGURAR_EN_RENDER
DB_SCHEMA=sicovi
DB_SSLMODE=require
# Optional stronger identity verification: mount the Supabase CA, then use verify-full.
# DB_SSLROOTCERT=/etc/secrets/supabase-ca.crt
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=sicovi-session
CACHE_STORE=database
CACHE_PREFIX=sicovi-production-cache-
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
SICOVI_DEMO_ACCOUNTS=false
